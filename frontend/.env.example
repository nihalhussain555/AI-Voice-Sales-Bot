# Backend origin. Leave EMPTY for local development: vite.config.js proxies /api
# to the backend, so requests stay same-origin and the session cookie needs no
# CORS allowance. (Recordings used to be a separate /recordings proxy; they are
# served from /api/recordings now and covered by the same rule.)
#
# Set it for any deployment where the frontend is hosted apart from the API,
# e.g. VITE_API_BASE_URL=https://voicepitch-api.onrender.com
VITE_API_BASE_URL=

# Only used by the dev server proxy when the backend runs elsewhere
# (a different port, or an ngrok tunnel for Twilio testing).
# VITE_PROXY_TARGET=http://localhost:3001
