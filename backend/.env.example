# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Groq (single provider for LLM + STT + TTS) ──────────
# Free key from https://console.groq.com/keys
# The app runs in "demo mode" (built-in Smart Sales Engine) without a key,
# but real AI conversation REQUIRES this key.
GROQ_API_KEY=

# Optional model overrides (defaults verified current Nov 2026)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy

# ── Twilio telephony (optional — real phone calls) ──────
# Leave empty to disable the phone feature entirely.
# SID + TOKEN make inbound calls work; PHONE_NUMBER + PUBLIC_BASE_URL are
# additionally required before the app will place an outbound call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL of this server (e.g. ngrok) so Twilio webhooks can reach it.
PUBLIC_BASE_URL=

# Set to 'false' only for local TwiML testing without signature validation.
TWILIO_VALIDATE=true

# Ask Twilio to POST call progress (ringing/answered/busy/no-answer/canceled)
# to /api/twilio/events. Without this the app can still finish calls from the
# audio stream, but cannot tell busy from no-answer. Default: true.
TWILIO_STATUS_CALLBACK=true

# Simultaneous phone calls allowed. Further inbound callers hear a "agents are
# busy" message and further outbound dials are refused with HTTP 429. Default: 3.
TWILIO_MAX_CONCURRENT_CALLS=3

# Hard cap per phone call in minutes (Groq usage guardrail).
MAX_CALL_MINUTES=15

# ── HTTP surface ────────────────────────────────────────
# Comma-separated list of frontend origins that may send credentialed requests,
# e.g. CORS_ORIGIN=https://voicepitch.vercel.app,http://localhost:5173
# Leave it as '*' to mean "same-origin only": the SPA served from this server,
# or the Vite dev proxy, needs no entry here. Outside production any
# localhost/127.0.0.1 origin is accepted so local development just works — but a
# wildcard is never turned into "allow every site on the internet", because the
# session travels in a cookie.
CORS_ORIGIN=*

# Number of reverse-proxy hops to trust for the client IP (X-Forwarded-For).
# Leave at 1 when the app sits behind one proxy (Render, nginx). Set to 0/false
# when running directly, so a forged header cannot buy extra rate-limit budget.
# TRUST_PROXY=1

# Max request body (audio recordings are posted here).
BODY_LIMIT=50mb

# Serve ../frontend/dist from this port. Auto-disabled when that folder is
# absent, which is exactly the case on a Render-only deployment.
SERVE_FRONTEND=true

# ── Accounts & sessions ─────────────────────────────────
# Passwords are bcrypt-hashed at a fixed cost of 11 (models/users.js — not
# configurable, because 11 is the value measured to stay under ~100 ms and so
# off the live call audio loop) and are never returned by an API or logged.
# Sessions are random tokens stored only as SHA-256 hashes, in
# DATA_DIR/sessions.json, and are revoked server-side on logout.
PASSWORD_MIN_LENGTH=8

# Idle lifetime of a normal session, refreshed on each request.
SESSION_TTL_MINUTES=720
# Lifetime when "remember me" is ticked at sign-in.
REMEMBER_TTL_MINUTES=43200
# Lifetime of a password reset link. They are single-use either way.
RESET_TTL_MINUTES=30

# SameSite / Secure on the vp_session cookie. COOKIE_SECURE defaults to on in
# production and off elsewhere, so plain http://localhost keeps working; switch
# to None only if the frontend and backend are on different *sites* and you are
# serving over HTTPS.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# Cap on accounts this instance creates. 0 = unlimited. Useful for a private
# deployment; when it is hit, registration returns 503 and the sign-up form says
# so instead of failing mysteriously.
MAX_USERS=0

# ── Login throttling ────────────────────────────────────
# Counted per client address *and* email for sign-in, so hammering one account
# does not lock out a different one behind the same NAT.
LOGIN_RATE_MAX=8
LOGIN_RATE_WINDOW_MINUTES=15
SIGNUP_RATE_MAX=10
SIGNUP_RATE_WINDOW_MINUTES=60
FORGOT_RATE_MAX=5
FORGOT_RATE_WINDOW_MINUTES=15

# ── Password reset email ────────────────────────────────
# Without these the reset form still answers honestly ("if that address has an
# account…") and logs a warning instead of pretending to send. In development,
# where no transport is configured, the real link is echoed to the server
# console so the flow can be tested; AUTH_ECHO_RESET_LINK=false switches that
# off, and it is off by default in production.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="VoicePitch AI <no-reply@example.com>"
# APP_BASE_URL=https://voicepitch.example.com
# AUTH_ECHO_RESET_LINK=true

# ── Storage locations (optional) ────────────────────────
# Defaults to backend/src/data and backend/src/recordings. Override to point at
# a persistent disk on a host whose filesystem is wiped between deploys.
# DATA_DIR=/var/tmp/voicepitch/data
# RECORDINGS_DIR=/var/tmp/voicepitch/recordings
